{"topics":[{"categoryUrl":"https:\/\/en.community.sonos.com\/speakers-229128","topicUrl":{"destination":"https:\/\/en.community.sonos.com\/speakers-229128\/zone-speakers-are-separate-without-interaction-since-the-last-apps-update-6934361"},"id":"146132","publicId":"6934361","title":"Zone speakers are separate without interaction since the last apps update","content":"\u003Cp\u003EHello\u003C\/p\u003E\u003Cp\u003EI\u2019ve been using zone with four Era 100 in my sun room since last fall. No issue to report, it\u2019s perfect to play ambiance music in a large area. But since the last app update, my zone disappear and all 4 speakers become separate.\u003C\/p\u003E\u003Cp\u003EAm I the only one ?\u00a0 Is it a known issue ?\u00a0\u003C\/p\u003E\u003Cp\u003EI\u2019m using Alexa and\u00a0\u003C\/p\u003E","categoryName":"Speakers","categoryId":"229128","contentType":"question","featuredImage":"","featuredImageAltText":"","likes":0,"views":264,"votes":0,"replyCount":12,"publishedAt":"2026-07-20T12:03:29+00:00","lastActivityAt":"2026-11-06T17:23:24+00:00","lastContributor":{"id":"8038823","username":"nik9669a","avatar":""},"lastPostId":540668,"author":{"id":"8239354","username":"Yubi","avatar":""},"sticky":false,"publicLabel":"","ideaStatus":{"name":"","textColor":"","backgroundColor":""},"hasBestAnswer":true,"productAreas":[],"bugStatus":{"name":"","textColor":"","backgroundColor":""},"inclusiveVisibleReplyCount":14,"likedOrVotedByCurrentUser":false,"timestampDisplayText":"7 hours ago","publishedAtDisplayText":"Jul 20, 2026 12:03 PM UTC","unreadRepliesCount":0,"isUnreadPostCountEnabled":false,"isNew":false,"lastActivityAtRelative":"7 hours ago","publishedAtRelative":"3 months ago","lastReplyPublicId":"16900849"},{"categoryUrl":"https:\/\/en.community.sonos.com\/speakers-229128","topicUrl":{"destination":"https:\/\/en.community.sonos.com\/speakers-229128\/support-for-new-time-zone-6935146"},"id":"146682","publicId":"6935146","title":"Support for new time zone","content":"\u0